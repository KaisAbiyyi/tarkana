# Database connection for Drizzle and backend migrations
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection without pooler (recommended for migrations/DDL)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase public credentials (browser safe)
PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_[KEY]"

{
	"name": "tarkana",
	"private": true,
	"version": "0.1.0-beta.2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test": "npm run test:unit && npm run test:e2e",
		"test:e2e": "node scripts/run-e2e.mjs",
		"benchmark": "node scripts/run-generator-benchmark.mjs",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:prod": "node scripts/migrate-production.mjs",
		"db:seed": "node scripts/seed.mjs",
		"db:cleanup": "node scripts/maintenance-cleanup.mjs",
		"maintenance": "node scripts/maintenance-cleanup.mjs",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"@types/pg": "^8.20.0",
		"@vitest/browser-playwright": "^4.1.8",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"playwright": "^1.59.1",
		"postgres": "^3.4.9",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"@supabase/ssr": "^0.10.3",
		"@supabase/supabase-js": "^2.105.4",
		"dotenv": "^17.4.2",
		"gsap": "^3.15.0",
		"pg": "^8.22.0"
	}
}
